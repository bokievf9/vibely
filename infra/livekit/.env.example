# Copy to /opt/vibely-media/.env on the media droplet, chmod 600. Never commit the real file.
# Generate the secret with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Same values as LIVEKIT_API_KEY / LIVEKIT_API_SECRET in the app's shared/.env.production.
# The key id must also equal webhook.api_key in livekit.yaml.
LIVEKIT_API_KEY=vibely-1
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long-random
# What livekit-server accepts (YAML): "<key>: <secret>"; during a rotation a flow map:
#   LIVEKIT_KEYS={vibely-1: old-secret, vibely-2: new-secret}
LIVEKIT_KEYS=vibely-1: change-me-at-least-32-characters-long-random

# Write access to the recordings bucket (egress uploads). Spaces: a key limited to this bucket.
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=

# Daily retention job (cron on this droplet → POST https://vibelydate.com/api/calls/purge).
CALLS_PURGE_SECRET=

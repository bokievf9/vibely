# Supabase (Project Settings → API Keys). The anon key or the new publishable key both work here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio (used by supabase/config.toml for local SMS OTP)
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Scheduled jobs (POST /api/cron/retention, 90-day media/selfie purge). Optional, >= 32 chars:
# openssl rand -hex 32. The same value goes into the GitHub Actions secret CRON_SECRET.
CRON_SECRET=
# Calls (optional, docs/calls.md). All three LIVEKIT_* set = calls on; otherwise hidden.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Bearer secret of POST /api/calls/purge (daily retention cron); at least 32 characters.
CALLS_PURGE_SECRET=
# Recordings bucket (DigitalOcean Spaces). Unset = the Supabase bucket "call-recordings".
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_REGION=
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=
RECORDINGS_S3_FORCE_PATH_STYLE=true

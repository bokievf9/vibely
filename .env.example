# Supabase (Project Settings → API Keys). The anon key or the new publishable key both work here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio (used by supabase/config.toml for local SMS OTP)
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Scheduled jobs (POST /api/cron/retention, 90-day media/selfie purge). Optional, >= 32 chars:
# openssl rand -hex 32. The same value goes into the GitHub Actions secret CRON_SECRET.
CRON_SECRET=
